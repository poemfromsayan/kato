# Copia este archivo a ".env" y completa los valores reales.
# ".env" nunca debe subirse a git (ver .gitignore).

NODE_ENV=development
PORT=3001

# Postgres — en producción usa siempre SSL (?sslmode=require) y un usuario
# con permisos mínimos (no el superusuario).
DATABASE_URL=postgres://localhost:5432/katofit

# Dominios permitidos para CORS, separados por coma. Nunca uses "*" en producción.
CORS_ORIGIN=http://localhost:5173

# Firma de los JSON Web Tokens de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Claude API (https://console.anthropic.com) — usado únicamente para extraer
# texto estructurado de los planes nutricionales subidos, nunca para decidir precios.
ANTHROPIC_API_KEY=

# Tamaño máximo de PDF aceptado en la subida de planes (bytes). 10MB por defecto.
MAX_UPLOAD_BYTES=10485760
