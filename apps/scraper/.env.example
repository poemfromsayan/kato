# Copia a ".env" y completa. Es la MISMA base de datos que usa apps/api —
# el scraper no tiene su propio esquema, escribe directo a las tablas
# stores / store_products / price_snapshots definidas en
# apps/api/src/db/migrations.
DATABASE_URL=postgres://katofit:changeme@localhost:5432/katofit

# Cuántos productos procesar por corrida antes de pausar (control de carga /
# buen comportamiento frente a los sitios que visitamos).
BATCH_SIZE=50

# Delay mínimo entre requests al mismo sitio, en segundos.
REQUEST_DELAY_SECONDS=2
